{
  "name": "morph-browser",
  "version": "1.0.0",
  "description": "Morph Browser — run isolated browser profiles with their own data, proxy and fingerprint",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/*.test.js",
    "fetch-chromium": "node scripts/fetch-chromium.js",
    "dist": "npm run build:renderer && electron-builder",
    "build:renderer": "node scripts/build-renderer.mjs"
  },
  "build": {
    "appId": "dev.morphbrowser.app",
    "productName": "Morph Browser",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png",
      "build/badges/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${name}-${version}-windows-setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "${name}-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${name}-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "ppouria",
      "repo": "morph-browser"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "proxy-chain": "^3.0.1",
    "socks": "^2.8.10"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": {
    "name": "ppouria",
    "email": "ppouria@users.noreply.github.com"
  },
  "desktopName": "morph-browser.desktop",
  "license": "MIT"
}
